#!/usr/bin/env bash
# Git pre-commit hook for balls.
#
# Blocks any commit that:
#   1. Has clippy warnings or compiler warnings
#   2. Contains a Rust source file >= 300 lines
#   3. Has failing tests
#   4. Drops line coverage below 100%
#   5. Has any rustdoc warning — a broken intra-doc link included
#
# To install: scripts/install-hooks.sh

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Git invokes a hook with GIT_DIR, GIT_INDEX_FILE and friends exported.
# They leak into every `git` subprocess the gates spawn: tests that
# `git init` a tempdir then `git add`/`git commit` would have those
# commands silently retarget THIS repo's index instead (GIT_DIR beats
# the child's chosen working directory). Scrub git's repo-local env so
# clippy, the tests and tarpaulin run as if from a clean shell.
unset $(git rev-parse --local-env-vars)

# Verdict cache (bl-1263, design docs/design/bl-24e7-speculative-merge-queue.md):
# the gate verdict is a pure function of the tree it tests and the gate that
# tests it. If this exact worktree tree already passed this exact gate — an
# earlier run here, or a trusted speculator ahead of the merge queue — the run
# below would re-execute a known result, so skip it. An absent binary, an
# absent verdict, or any error all fall through to the stock gate (fail-open):
# deleting the cache restores stock behavior exactly.
if command -v bl-speculate >/dev/null 2>&1 && bl-speculate check 2>/dev/null; then
    echo "pre-commit: verdict cache hit — this exact tree already passed this exact gate."
    exit 0
fi

echo "pre-commit: clippy..."
cargo clippy --all-targets -- -D warnings 2>&1

# The blessed doc build (bl-3d09). The invocation lives ONLY in the Makefile —
# this gate just runs it, so the flags have one home.
echo "pre-commit: docs..."
make doc

echo "pre-commit: line lengths..."
"$ROOT/scripts/check-line-lengths.sh"

echo "pre-commit: tests..."
cargo test --quiet 2>&1

echo "pre-commit: coverage..."
"$ROOT/scripts/check-coverage.sh"

# Warm the cache with the verdict just earned — the next fold to this exact
# tree (a queued close behind this one, or a retry) skips the whole run.
# Fail-open: recording is never allowed to block a pass.
if command -v bl-speculate >/dev/null 2>&1; then
    bl-speculate record pass 2>/dev/null || true
fi

echo "pre-commit: OK."
